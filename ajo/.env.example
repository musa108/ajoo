# ---- web (apps/web): copy to apps/web/.env.local
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_CHAIN_NAME=Monad Testnet
NEXT_PUBLIC_NATIVE_SYMBOL=MON
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com
# VERIFY the four values above against Monad's docs before use. They are from memory, not from a source I could open.

# Addresses come from contracts/deployments/<chainId>.json after `npm run abi`; override here if you prefer.
# NEXT_PUBLIC_FACTORY_ADDRESS=
# NEXT_PUBLIC_REGISTRY_ADDRESS=
# NEXT_PUBLIC_TOKEN_ADDRESS=
# NEXT_PUBLIC_CREDIT_POOL_ADDRESS=
# NEXT_PUBLIC_TOKEN_IS_MOCK=1          # 1 shows the test-dollar faucet and the 5-minute demo cycle

NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ---- keeper (apps/keeper)
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
NATIVE_SYMBOL=MON
KEEPER_PRIVATE_KEY=            # a dedicated hot wallet holding a little gas, nothing else
# FACTORY_ADDRESS= CREDIT_POOL_ADDRESS=   (default to the deployment file)
POLL_MS=15000
REMIND_BEFORE_SEC=21600
MAX_TX_PER_LOOP=10
# WEBHOOK_URL=                  # POSTs {kind,text,...} for reminders and settlements (Telegram relay, Slack, n8n)
# START_BLOCK=0                 # first block to scan for credit-pool Borrowed events

# ---- contracts deploy
# PRIVATE_KEY=                  # deployer / owner
# TOKEN=                        # existing stablecoin; leave empty to deploy MockUSD (testnet only)
